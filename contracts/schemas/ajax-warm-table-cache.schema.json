{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ajaxWarmTableCache",
  "description": "Background snapshot warming AJAX request from view_updater_table_warmup.js to ViewUpdater.php",
  "type": "object",
  "required": ["nonce", "subpage"],
  "additionalProperties": false,
  "properties": {
    "nonce": { "type": "string", "minLength": 1 },
    "subpage": {
      "type": "string",
      "enum": ["abj404_redirects", "abj404_captured"]
    },
    "page": { "type": "string" },
    "rowsPerPage": { "type": ["string", "integer"] },
    "filterText": { "type": "string" },
    "filter": { "type": "string" }
  }
}
