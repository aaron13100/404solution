{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ajaxAdvanceViewBuild",
  "description": "Staged view-build progression AJAX request from view_updater_build_advance.js to ViewUpdater.php",
  "type": "object",
  "required": ["nonce"],
  "additionalProperties": false,
  "properties": {
    "nonce": { "type": "string", "minLength": 1 },
    "page": { "type": "string" },
    "subpage": { "type": "string" },
    "requestId": { "type": "string", "pattern": "^[a-zA-Z0-9]{8,64}$" },
    "forceViewRebuild": { "type": "string", "enum": ["0", "1"] }
  }
}
